# ⚠️ CHIFFREMENT AU REPOS — À RENSEIGNER AVANT TOUTE MISE EN SERVICE
# Sans DATA_KEY, le store, les feuilles d'émargement, les signatures manuscrites
# et les pièces de la GED sont écrits EN CLAIR sur le disque. En production
# (NODE_ENV=production) l'application refuse de démarrer sans elle ; hors Docker,
# elle se contente d'un avertissement — d'où ce rappel en tête de fichier.
# Générer : openssl rand -base64 48
# ⚠️ NE JAMAIS LA PERDRE : sans elle, les données sont irrécupérables.
DATA_KEY=

# --- IA ---
# Cle API OpenAI (console/platform.openai.com -> API Keys)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5           # livrables (P&L, CR, ordre du jour)
OPENAI_MODEL_LIGHT=gpt-4.1     # triage email (haut volume)

# --- Acces page ---
APP_PASSWORD=change-moi
SESSION_SECRET=change-moi-aussi   # openssl rand -hex 32
PORT=3200

# --- Phase 2 : Gmail + agenda (brief du matin) ---
# Adresse Gmail a traiter + MOT DE PASSE D'APPLICATION Google (16 lettres, PAS le mdp du compte)
# (myaccount.google.com/apppasswords ; necessite la validation en 2 etapes)
GMAIL_USER=prenom@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
BRIEF_TO=                      # destinataire du brief (defaut : GMAIL_USER)
ICAL_URL=                      # URL iCal privee Google Agenda (facultatif)
BRIEF_CRON=30 7 * * *         # heure d'envoi (defaut 7h30, fuseau Europe/Paris)
BRIEF_HOURS=24                # fenetre d'emails a traiter
BRIEF_MAX=40                  # nb max d'emails analyses
